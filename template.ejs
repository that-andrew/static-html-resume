<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title %></title>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="./dist/output.css" rel="stylesheet">
</head>
<body class=" print:bg-white print:text-gray-950 bg-background text-foreground flex justify-center py-5 print:py-0">
  <main class="w-full max-w-[210mm] min-h-[297mm] p-5 shadow-lg print:shadow-none print:p-2 print:m-2 box-border relative">
    

    <div class="absolute top-0 right-0 flex items-center justify-end gap-3 print:hidden ">
      <button
        id="themeToggle"
        type="button"
        class="group relative inline-flex items-center gap-3 px-3 py-2 shadow-sm backdrop-blur transition "
        aria-label="Toggle theme"

      >
        <span class="text-xs font-semibold" id="themeModeLabel">
          <span class="theme-auto:hidden">
            <span class="not-dark:hidden"></span>
            <span class="dark:hidden"></span>
          </span>
          <span class="not-theme-auto:hidden">Auto</span>
        </span>

        <span class="grid h-6 w-6 place-items-center" id="themeIcon">
          <span class="theme-auto:hidden">
            <span class="not-dark:hidden"><i data-lucide="sun" class="w-6 h-6"></i></span>
            <span class="dark:hidden"><i data-lucide="moon" class="w-6 h-6"></i></span>
          </span>
          <span class="not-theme-auto:hidden"><i data-lucide="sun-moon" class="w-6 h-6"></i></span>
        </span>

      </button>
    </div>

    <% if (page.header) { %>
      <header class="pb-2 mb-1 break-inside-avoid prose prose-sm sm:prose-base max-w-none dark:prose-invert prose-neutral">
        <% if (page.header.title) { %>
          <h1 class="mb-0 pb-0 text-4xl font-bold tracking-tight not-prose"><%= page.header.title %></h1>
        <% } %>
        <% if (page.header.subTitle) { %>
          <div class="text-2xl mb-4 text-foreground/90 font-medium prose"><%= page.header.subTitle %></div>
        <% } %>
        <% if (page.header.contact) { %>
          <div class="border-b border-t border-foreground/20 flex flex-wrap gap-4 text-sm bg-accent print:bg-white text-accent-foreground/80 mt-2 p-2 not-prose items-center justify-between">
            <% if (page.header.contact.email) { %>
              <span class="flex flex-nowrap items-center justify-between gap-1">
                <i data-lucide="mail" class="w-4 h-4"></i>
                <%= page.header.contact.email %>
              </span>
            <% } %>
            <% if (page.header.contact.phone) { %>
            <span class="flex flex-nowrap items-center justify-between gap-1">
              <i data-lucide="phone" class="w-4 h-4"></i>
              <%= page.header.contact.phone %>
            </span>
            <% } %>
            <% if (page.header.contact.location) { %>
            <span class="flex flex-nowrap items-center justify-between gap-1">
              <i data-lucide="map-pin" class="w-4 h-4"></i>
              <%= page.header.contact.location %>
            </span>
            <% } %>
            <% if (page.header.contact.website) { %>
            <a href="<%= page.header.contact.website.url %>" class="flex flex-nowrap items-center justify-between gap-1 text-blue-600 dark:text-blue-400 print:text-gray-950 underline">
              <i data-lucide="git-fork" class="w-4 h-4"></i>
              <%= page.header.contact.website.label %>
            </a>
            <% } %>
          </div>
        <% } %>

        <% if (page.header.tags && page.header.tags.length > 0) { %>
            <div class="flex flex-wrap justify-center gap-x-1 gap-y-1 w-full my-2 break-inside-avoid">
              <% page.header.tags.forEach(function(tag) { %>
                <div class="rounded-full bg-accent text-accent-foreground print:bg-white print:text-gray-600 print:border-gray-600 max-w-fit px-2 whitespace-nowrap border border-accent-foreground/20"><%= tag %></div>
                <% }) %>
            </div>
        <% } %>

        <% if (page.header.summary && page.header.summary.length > 0) { %>
        <section class="mb-2 break-inside-avoid">
          <h2 class="mb-4 mt-4 border-b border-foreground/60 pb-1 not-prose text-2xl font-bold">Summary</h2>
          <p><%= page.header.summary %></p>
        </section>
        <% } %>
      </header>
    <% } %>
    
      


      <% page.articles.forEach(function(article,index) { %>
        <% if (article.breakBefore) { %>
          <div class="break-before-page mb-4 mt-4"></div>
        <% } %>
        <article class="mb-2 mt-4 prose prose-sm sm:prose-base max-w-none dark:prose-invert prose-neutral">

          <h2 class="mb-4 mt-4 border-b border-foreground/60 pb-1 not-prose text-2xl font-bold"><%= article.title %></h2>
          
          <% article.sections.forEach(function(section) { %>
            <section>
              <div class="mb-6 break-inside-avoid">
                <div class="flex justify-between items-baseline not-prose flex-nowrap whitespace-nowrap">
                  <h3 class="text-lg font-semibold text-foreground">
                    <span class="whitespace-nowrap"><%= section.title %></span>
                  </h3>
                  <% if (section.website) { %>
                    <a href="<%= section.website.url %>" class="ml-auto flex flex-nowrap items-center justify-between gap-1 text-blue-600 dark:text-blue-400 print:text-gray-950 underline">
                      <i data-lucide="git-fork" class="w-4 h-4"></i>
                      <%= section.website.label %>
                    </a>
                  <% } else if(section.date) { %>
                    <span class="not-prose text-sm font-medium text-foreground/80 whitespace-nowrap"><%= section.date %></span>
                  <% } %>
                </div>
                
                <% if (section.subTitle) { %>
                  <div class="flex justify-start items-baseline mb-2 not-prose">
                    <div class="whitespace-nowrap text-lg text-foreground/80 font-"><em><%= section.subTitle %></em></div>
                  </div>
                <% } %>
                
                <% if (section.points && section.points.length > 0) { %>
                  <ul class="">
                    <% section.points.forEach(function(point) { %>
                      <li><%= point %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
              <% if (section.content && section.content.length > 0) { %>
                  <% section.content.forEach(function(paragraph) { %>
                    <p class=""><%= paragraph %></p>
                  <% }) %>
              <% } %>
            </section>
          <% }) %>
          
        </article>
      <% }) %>

    </article>
  </main>
  <script>
    lucide.createIcons();
  </script>
  <script>
  
  
  const STORAGE_KEY = "theme"; // "light" | "dark"
  const root = document.documentElement;

  const toggleBtn = document.getElementById("themeToggle");
  const themeIcon = document.getElementById("themeIcon");
  const themeModeLabel = document.getElementById("themeModeLabel");
  const themeHint = document.getElementById("themeHint");

  function systemPref() {
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function savedTheme() {
    const v = localStorage.getItem(STORAGE_KEY);
    return v === "dark" || v === "light" ? v : null;
  }

  function applyTheme(theme, source) {
    const isDark = theme === "dark";
    const isLight = theme === "light";
    const isSystem = source === "system";
    const currentSystemTheme = systemPref();

    if (isSystem) {
      root.setAttribute("data-theme-source", "system");
    } else {
      root.removeAttribute("data-theme-source");
    }

    root.classList.toggle("dark", isDark);
    root.setAttribute("data-theme", isDark ? "dark" : "light");

    if (toggleBtn) {
      toggleBtn.title =
        source === "saved"
          ? isLight
            ? `Click to use dark theme.`
            : `Click to follow system theme (${currentSystemTheme}).`
          : `Click to use ${currentSystemTheme === "dark" ? "light" : "dark"} theme.`;
    }
  }

  // init
  const initial = savedTheme() ?? systemPref();
  applyTheme(initial, savedTheme() ? "saved" : "system");

  toggleBtn.addEventListener("click", () => {
    const currentTheme = root.getAttribute("data-theme");
    const currentThemeSource = root.getAttribute("data-theme-source");

    if (currentThemeSource === "system") {
      const currentSystemTheme = systemPref();
      const next = currentSystemTheme === "dark" ? "light" : "dark";
      localStorage.setItem(STORAGE_KEY, next);
      applyTheme(next, "saved");
    } else if (currentTheme === "light") {
      localStorage.setItem(STORAGE_KEY, "dark");
      applyTheme("dark", "saved");
    } else if (currentTheme === "dark") {
      localStorage.setItem(STORAGE_KEY, null);
      applyTheme(systemPref(), "system");
    }
  });

  // If user has not chosen explicitly, follow OS changes
  const mql = window.matchMedia("(prefers-color-scheme: dark)");
  mql.addEventListener?.("change", () => {
    if (savedTheme() === null) applyTheme(systemPref(), "system");
  });
</script>
</body>
</html>