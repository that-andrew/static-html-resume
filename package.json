{
  "name": "static-html-resume",
  "version": "1.0.0",
  "description": "",
  "main": "build.js",
  "scripts": {
    "build": "node build.js data.json && npm run build:css",
    "build:demo": "node build.js example_data.json && npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "dev": "node build.js data.json && npm run dev:css",
    "dev:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/that-andrew/static-html-resume.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/that-andrew/static-html-resume/issues"
  },
  "homepage": "https://github.com/that-andrew/static-html-resume#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "ejs": "^6.0.1",
    "lucide": "^1.17.0",
    "node-gyp": "^13.0.1",
    "rebuild": "^0.1.2",
    "tailwindcss": "^4.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
