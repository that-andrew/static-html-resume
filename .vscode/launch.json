  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run build && npm run dev:css",
      "name": "Run build & watch",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "type": "editor-browser",
      "request": "attach",
      "name": "attach browser against localhost",
      "url": "http://127.0.0.1:3000/resume.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
