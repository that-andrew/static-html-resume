<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= document.title %>
  </title>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="output.css" rel="stylesheet">
</head>

<body class="relative bg-muted">
  <div class="page-toolbar mx-auto w-full max-w-[210mm] flex items-center justify-between py-1 gap-3 print:hidden">
    <div class="flex flex-nowrap items-center justify-end gap-6 grow">
      <button type="button" value="Print" onclick="window.print()" aria-label="Print Page" title="Print Page">
        <i data-lucide="printer" class="w-6 h-6"></i><span class="text-xs font-semibold">Print</span>
      </button>
      <button id="themeToggle" type="button" class="group" aria-label="Toggle theme">
        <span class="grid h-6 w-6 place-items-center" id="themeIcon">
          <span class="theme-auto:hidden">
            <span class="not-dark:hidden"><i data-lucide="sun" class="w-6 h-6"></i></span>
            <span class="dark:hidden"><i data-lucide="moon" class="w-6 h-6"></i></span>
          </span>
          <span class="not-theme-auto:hidden"><i data-lucide="sun-moon" class="w-6 h-6"></i></span>
        </span>
        <span class="text-xs font-semibold" id="themeModeLabel">
          <span class="theme-auto:hidden">
            <span class="not-dark:hidden">Light</span>
            <span class="dark:hidden">Dark</span>
          </span>
          <span class="not-theme-auto:hidden">Auto</span>
        </span>
      </button>
    </div>
  </div>
  <div class="flex flex-col min-h-screen">
    <main class="mb-auto">
      <div class="document-container min-h-screen">
        <% if (document.pages && document.pages.length> 0) { %>
          <% document.pages.forEach(function(page,index) { %>
            <div class="page-container bg-card print:bg-white shadow-lg relative shadow-page-shadow ">
              <header class="pb-2 mb-1 break-inside-avoid  max-w-none ">
                <% if (page.title) { %>
                  <% if (page.isContinued) { %>
                    <h2 class="mb-0 pb-0 text-2xl font-bold tracking-tight not-prose">
                      <%= page.title %> (Continued)
                    </h2>
                  <% } else { %>
                    <h1 class="mb-0 pb-0 text-4xl font-bold tracking-tight not-prose">
                      <%= page.title %>
                    </h1>
                  <% } %>
                <% } %>
                <div class="sub-heading text-2xl mb-4 font-medium not-prose">
                  <%= document.meta.applicantName %>
                </div>
              </header>

              <% if (page.contactBar) { %>
                <div
                  class="contact-bar border-b border-t border-foreground/20 flex flex-wrap gap-4 text-sm bg-accent text-accent-foreground mt-2 p-2 not-prose items-center justify-between">
                  <% if (page.contactBar.email) { %>
                    <a href="<%= page.contactBar.email.url %>" target="_blank">
                      <span class="">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                        <%= page.contactBar.email.label %>
                      </span>
                    </a>
                    <% } %>
                      <% if (page.contactBar.phone) { %>
                        <a href="<%= page.contactBar.phone.url %>" target="_blank">
                          <span class="">
                            <i data-lucide="phone" class="w-4 h-4"></i>
                            <%= page.contactBar.phone.label %>
                          </span>
                        </a>
                        <% } %>
                          <% if (page.contactBar.location) { %>
                            <a href="<%= page.contactBar.location.url %>" target="_blank">
                              <span class="">
                                <i data-lucide="map-pin" class="w-4 h-4"></i>
                                <%= page.contactBar.location.label %>
                              </span>
                            </a>
                            <% } %>
                              <% if (page.contactBar.website) { %>
                                <a href="<%= page.contactBar.website.url %>" target="_blank">
                                  <span class="">
                                    <i class="github-icon icon accent-foreground w-4 h-4 "></i>
                                    <%= page.contactBar.website.label %>
                                  </span>
                                </a>
                                <% } %>
                </div>
                <% } %>
                  <% if (page.skillList && page.skillList.length> 0) { %>
                    <div
                      class="skill-list flex flex-wrap justify-center gap-x-1 gap-y-1 w-full my-2 break-inside-avoid">
                      <% page.skillList.forEach(function(tag) { %>
                        <div
                          class="rounded-full text-sm bg-accent text-accent-foreground max-w-fit px-2 whitespace-nowrap border border-accent-foreground/20">
                          <%= tag %>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                      <% page.articles.forEach(function(article,index) { %>

                        <article
                          class="mb-2 mt-4 max-w-none dark:prose-invert prose-neutral prose prose-sm sm:prose-base">
                          <h2 class="mb-4 mt-4 border-b border-foreground/60 pb-1 not-prose text-2xl font-bold">
                            <%= article.title %>
                          </h2>
                          <% article.sections.forEach(function(section) { %>
                            <section>
                              <div class="mb-0 break-inside-avoid">
                                <div
                                  class="flex justify-between items-baseline not-prose flex-nowrap whitespace-nowrap">
                                  <h3 class="text-lg font-semibold text-foreground">
                                    <span class="whitespace-nowrap">
                                      <%= section.title %>
                                    </span>
                                  </h3>
                                  <% if(section.date) { %>
                                    <span class="not-prose text-sm font-medium text-foreground/80 whitespace-nowrap">
                                      <%= section.date %>
                                    </span>
                                  <% } %>
                                  <% if (section.website) { %>
                                    <div class="not-prose max-w-1/2 whitespace-nowrap">
                                        <a href="<%= section.website.url %>" target="_blank">
                                          <span class="">
                                            <i class="icon github-icon bg-accent-foreground w-4 h-4"></i>
                                            <%= section.website.label %>
                                          </span>
                                        </a>
                                    </div>
                                  <% } %>
                                </div>

                                <% if (section.subTitle) { %>
                                  <div class="flex justify-start items-baseline mb-2 not-prose">
                                    <div class="whitespace-nowrap text-lg text-foreground/80 font-"><em>
                                        <%= section.subTitle %>
                                      </em></div>
                                  </div>
                                <% } %>

                                <% if (section.skillList && section.skillList.length> 0) { %>
                                  <div
                                    class="skill-list flex flex-wrap not-prose justify-center gap-x-0.5 gap-y-1 my-0 break-inside-avoid">
                                    <% section.skillList.forEach(function(tag) { %>
                                      <div
                                        class="rounded-xl text-sm bg-accent text-accent-foreground max-w-fit px-1.5 whitespace-nowrap border border-accent-foreground/20">
                                        <%= tag %>
                                      </div>
                                      <% }) %>
                                  </div>
                                <% } %>                                

                                <% if (section.list && section.list.length> 0) { %>
                                  <ul class="section-list leading-6">
                                    <% section.list.forEach(function(point) { %>
                                      <li>
                                        <%= point %>
                                      </li>
                                      <% }) %>
                                  </ul>
                                <% } %>
                              </div>
                              
                              <% if (section.content && section.content.length> 0) { %>
                                <% section.content.forEach(function(paragraph) { %>
                                  <p class="section-content first-of-type:mt-2">
                                    <%= paragraph %>
                                  </p>
                                  <% }) %>
                              <% } %>
                            </section>
                            <% }) %>
                        </article>
                        <% }) %>
            </div>
            <% }) %>
              <% } %>
      </div>
    </main>
  </div>
  <script>
    lucide.createIcons();
  </script>
  <script>
    const STORAGE_KEY = "theme";
    const root = document.documentElement;
    const toggleBtn = document.getElementById("themeToggle");
    const themeIcon = document.getElementById("themeIcon");
    const themeModeLabel = document.getElementById("themeModeLabel");
    const themeHint = document.getElementById("themeHint");

    function systemPref() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    function savedTheme() {
      const v = localStorage.getItem(STORAGE_KEY);
      return v === "dark" || v === "light" ? v : null;
    }

    function applyTheme(theme, source) {
      const isDark = theme === "dark";
      const isLight = theme === "light";
      const isSystem = source === "system";
      const currentSystemTheme = systemPref();

      if (isSystem) {
        root.setAttribute("data-theme-source", "system");
      } else {
        root.removeAttribute("data-theme-source");
      }

      root.classList.toggle("dark", isDark);
      root.setAttribute("data-theme", isDark ? "dark" : "light");

      if (toggleBtn) {
        toggleBtn.title =
          source === "saved"
            ? isLight
              ? `Click to use dark theme.`
              : `Click to follow system theme (${currentSystemTheme}).`
            : `Click to use ${currentSystemTheme === "dark" ? "light" : "dark"} theme.`;
      }
    }

    // init
    const initial = savedTheme() ?? systemPref();
    applyTheme(initial, savedTheme() ? "saved" : "system");

    toggleBtn.addEventListener("click", () => {
      const currentTheme = root.getAttribute("data-theme");
      const currentThemeSource = root.getAttribute("data-theme-source");

      if (currentThemeSource === "system") {
        const currentSystemTheme = systemPref();
        const next = currentSystemTheme === "dark" ? "light" : "dark";
        localStorage.setItem(STORAGE_KEY, next);
        applyTheme(next, "saved");
      } else if (currentTheme === "light") {
        localStorage.setItem(STORAGE_KEY, "dark");
        applyTheme("dark", "saved");
      } else if (currentTheme === "dark") {
        localStorage.setItem(STORAGE_KEY, null);
        applyTheme(systemPref(), "system");
      }
    });

    // If user has not chosen explicitly, follow OS changes
    const mql = window.matchMedia("(prefers-color-scheme: dark)");
    mql.addEventListener?.("change", () => {
      if (savedTheme() === null) applyTheme(systemPref(), "system");
    });
  </script>
</body>

</html>